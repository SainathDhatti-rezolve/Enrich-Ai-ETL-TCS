# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is git-ignored and docker-ignored, so secrets never get committed or
# baked into the image. These map to the ${ENV:VAR} placeholders in config.yaml.

# --- Production ETL SFTP (download sources + upload output) ---
ETL_SFTP_HOST=sftp.example.com
ETL_SFTP_USERNAME=etl_user
ETL_SFTP_PASSWORD=change_me
# Optional: use a private key instead of a password (leave blank if using password)
ETL_SFTP_KEY_PATH=

# --- Remote directories (absolute paths on the SFTP server) ---
ETL_DOWNLOAD_DIR=/enrich/imports
ETL_UPLOAD_DIR=/enrichai/EnrichAi Imports

# --- Push toggle ---
# false = download + transform only, do NOT push output back to SFTP (testing).
ETL_UPLOAD_ENABLED=true

# --- Timezone for output-file timestamps (scheduling is done by Cloud Composer) ---
ETL_SCHEDULE_TIMEZONE=America/Chicago


